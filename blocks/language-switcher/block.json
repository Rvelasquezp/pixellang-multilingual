{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wp-multilingual/language-switcher",
	"version": "1.4.0",
	"title": "Language Switcher",
	"category": "widgets",
	"icon": "translation",
	"description": "Links to the current page in the other languages of the site, in four designs: minimal, segmented, dropdown or select.",
	"keywords": [
		"language",
		"multilingual",
		"translation",
		"langue"
	],
	"textdomain": "pixellang-multilingual",
	"editorScript": "file:./editor.js",
	"viewScript": "file:./view.js",
	"style": "file:./style.css",
	"attributes": {
		"hideCurrent": {
			"type": "boolean",
			"default": false
		},
		"hideMissing": {
			"type": "boolean",
			"default": false
		},
		"design": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"minimal",
				"segmented",
				"dropdown",
				"select"
			]
		},
		"display": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"code",
				"name",
				"both"
			]
		},
		"separator": {
			"type": "string",
			"default": "none",
			"enum": [
				"none",
				"slash",
				"pipe",
				"dot"
			]
		},
		"size": {
			"type": "string",
			"default": "",
			"enum": [
				"",
				"small",
				"medium",
				"large"
			]
		},
		"showIcon": {
			"type": "boolean",
			"default": false
		},
		"menuAlign": {
			"type": "string",
			"default": "right",
			"enum": [
				"left",
				"right"
			]
		},
		"menuTheme": {
			"type": "string",
			"default": "light",
			"enum": [
				"light",
				"dark"
			]
		}
	},
	"supports": {
		"html": false,
		"align": [
			"left",
			"center",
			"right"
		],
		"color": {
			"text": true,
			"link": true,
			"background": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontFamily": true,
			"__experimentalTextTransform": true,
			"__experimentalLetterSpacing": true
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"__experimentalBorder": {
			"radius": true,
			"width": true,
			"color": true,
			"style": true
		}
	},
	"render": "file:./render.php",
	"example": {
		"attributes": {
			"design": "dropdown",
			"display": "both",
			"showIcon": true
		}
	},
	"editorStyle": "file:./editor.css"
}
