msgstr "Non traduites en %s"

#: admin/views/strings.php:192
#: admin/views/translations.php:93
msgid "Filter"
msgstr "Filtrer"

#: admin/views/strings.php:193
#: admin/views/translations.php:94
msgid "Search"
msgstr "Rechercher"

#: admin/views/strings.php:199
msgid "Delete the selected strings and their translations? The theme and plugin files are not affected."
msgstr "Supprimer les chaînes sélectionnées et leurs traductions? Les fichiers du thème et des extensions ne sont pas touchés."

#: admin/views/strings.php:210
msgid "Language of texts found in code"
msgstr "Langue des textes trouvés dans le code"

#: admin/views/strings.php:216
#: includes/class-strings-admin.php:282
