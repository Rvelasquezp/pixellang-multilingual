#. Plugin Name of the plugin
#: wp-multilingual.php
#: includes/class-admin.php:80
msgid "PixelLang Multilingual"
msgstr "PixelLang Multilingual"

#. Plugin URI of the plugin
#: wp-multilingual.php
msgid "https://github.com/Rvelasquezp/pixellang-multilingual"
msgstr "https://github.com/Rvelasquezp/pixellang-multilingual"

#. Description of the plugin
#: wp-multilingual.php
msgid "Multilingual WordPress without lock-in: languages, linked translations of posts, pages, custom post types and terms, language-aware menus, template parts and forms, hreflang and a language switcher block."
msgstr "WordPress multilingue sans dépendance : langues, traductions liées des articles, pages, types de contenu personnalisés et termes, menus, parties de modèle et formulaires selon la langue, hreflang et bloc sélecteur de langue."

#. Author of the plugin
#: wp-multilingual.php
msgid "Agence Pixel"
msgstr "Agence Pixel"

#. Author URI of the plugin
#: wp-multilingual.php
msgid "https://agencepixel.ca"
msgstr "https://agencepixel.ca"

