#. Plugin Name of the plugin
#: wp-multilingual.php includes/class-admin.php:78
msgid "PixelLang Multilingual"
msgstr "PixelLang Multilingual"

#. Plugin URI of the plugin
#: wp-multilingual.php
msgid "https://github.com/Rvelasquezp/pixellang-multilingual"
msgstr "https://github.com/Rvelasquezp/pixellang-multilingual"

#. Description of the plugin
#: wp-multilingual.php
msgid ""
"Multilingual WordPress without lock-in: languages, linked translations of "
"posts, pages, custom post types and terms, language-aware menus, template "
"parts and forms, hreflang, multilingual sitemaps, outdated translation "
"tracking, a language suggestion banner, and a language switcher block with "
"design options that can also be added automatically to menus or float on the "
"page."
msgstr ""
"WordPress multilingue sans dépendance : langues, traductions liées des "
"articles, pages, types de contenu et termes, menus, parties de modèle et "
"formulaires selon la langue, hreflang, plans de site multilingues, suivi des "
"traductions à mettre à jour, bannière de suggestion de langue et bloc "
"sélecteur de langue avec options de design, ajoutable automatiquement aux "
"menus ou flottant sur la page."

#. Author of the plugin
#: wp-multilingual.php
msgid "Agence Pixel"
msgstr "Agence Pixel"

#. Author URI of the plugin
#: wp-multilingual.php
msgid "https://agencepixel.ca"
msgstr "https://agencepixel.ca"

