msgstr "Outils"

#: admin/views/tools.php:18
msgid "Maintenance tasks. None of them deletes content."
msgstr "Tâches d’entretien. Aucune ne supprime de contenu."

#: admin/views/tools.php:24
msgid "Assign the default language to every selected content that has no language?"
msgstr "Attribuer la langue par défaut à tout le contenu sélectionné qui n’a pas de langue?"

#. translators: %s: default language name.
#: admin/views/tools.php:32
#, php-format
msgid "Content without language is set to %s. Useful right after installing the plugin on an existing site."
msgstr "Le contenu sans langue passe en %s. Utile juste après l’installation de l’extension sur un site existant."

#: admin/views/tools.php:54
msgid "Assign"
msgstr "Attribuer"

#: admin/views/tools.php:61
msgid "Recalculate statistics"
msgstr "Recalculer les statistiques"

#: admin/views/tools.php:62
msgid "Counters are cached for one hour and refreshed when content changes. Recalculate them after an import or a direct database change."
msgstr "Les compteurs sont mis en cache une heure et actualisés quand le contenu change. Recalculez-les après une importation ou une modification directe de la base."

#: admin/views/tools.php:63
msgid "Recalculate"
msgstr "Recalculer"

#: admin/views/tools.php:68
msgid "Repair template parts"
msgstr "Réparer les parties de modèle"

